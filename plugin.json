{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ralph-wiggum-loop",
  "version": "1.1.0",
  "description": "Multi-model iterative development agent plugin — Ralph Loop with cross-model worker/reviewer architecture, spec-driven development skills, Stop hooks, and SHIP/REVISE decision engine.",
  "author": {
    "name": "sheldonrobinson",
    "email": "sheldon.robinson@gmail.com",
    "url": "https://github.com/sheldonrobinson"
  },
  "homepage": "https://sheldonrobinson.github.io/ralph-wiggum-loop",
  "repository": "https://github.com/sheldonrobinson/ralph-wiggum-loop",
  "license": "MIT",
  "keywords": [
    "ralph-loop",
    "ralph-wiggum",
    "multi-model",
    "iterative-development",
    "spec-driven-development",
    "mcp",
    "agent-plugin",
    "llm",
    "code-review",
    "cross-model-review",
    "self-improvement"
  ],
  "extensions": {
    "com.anthropic.claude-code": {
      "hooks": "./com.anthropic.claude-code/hooks/hooks.json",
      "commands": [
        "./com.anthropic.claude-code/commands/ralph-loop.md",
        "./com.anthropic.claude-code/commands/cancel-ralph.md",
        "./com.anthropic.claude-code/commands/help.md"
      ]
    }
  }
}
